{
  "name": "dzencode_test",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build main-gateway-service",
    "format": "prettier --write \"{apps,libs}/**/*.ts\" \"*.json\"",
    "start": "nest start main-gateway-service",
    "start:gateway": "nest start main-gateway-service --watch",
    "start:file": "nest start micro-file-service --watch",
    "start:post": "nest start micro-post-service --watch",
    "start:debug": "nest start main-gateway-service --debug --watch",
    "start:prod": "node dist/apps/main-gateway-service/main",
    "infra:up": "docker compose up -d --wait",
    "infra:stop": "docker compose stop",
    "infra:down": "docker compose down",
    "infra:restart": "docker compose restart",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs -f",
    "db:up": "docker compose up -d --wait dzencode-postgres",
    "db:down": "docker compose down",
    "db:ps": "docker compose ps",
    "db:logs": "docker compose logs dzencode-postgres",
    "db:prepare": "pnpm db:up && pnpm prisma:generate && pnpm prisma:migrate:deploy",
    "contracts:lint": "buf lint libs/contracts",
    "contracts:generate": "buf generate libs/contracts --template libs/contracts/buf.gen.yaml",
    "prisma:validate:gateway": "prisma validate --config apps/main-gateway-service/prisma/prisma.config.ts",
    "prisma:validate:post": "prisma validate --config apps/micro-post-service/prisma/prisma.config.ts",
    "prisma:validate:file": "prisma validate --config apps/micro-file-service/prisma/prisma.config.ts",
    "prisma:validate": "pnpm prisma:validate:gateway && pnpm prisma:validate:post && pnpm prisma:validate:file",
    "prisma:generate:gateway": "prisma generate --config apps/main-gateway-service/prisma/prisma.config.ts",
    "prisma:generate:post": "prisma generate --config apps/micro-post-service/prisma/prisma.config.ts",
    "prisma:generate:file": "prisma generate --config apps/micro-file-service/prisma/prisma.config.ts",
    "prisma:generate": "pnpm prisma:generate:gateway && pnpm prisma:generate:post && pnpm prisma:generate:file",
    "prisma:migrate:dev:gateway": "prisma migrate dev --config apps/main-gateway-service/prisma/prisma.config.ts",
    "prisma:migrate:dev:post": "prisma migrate dev --config apps/micro-post-service/prisma/prisma.config.ts",
    "prisma:migrate:dev:file": "prisma migrate dev --config apps/micro-file-service/prisma/prisma.config.ts",
    "prisma:migrate:deploy:gateway": "prisma migrate deploy --config apps/main-gateway-service/prisma/prisma.config.ts",
    "prisma:migrate:deploy:post": "prisma migrate deploy --config apps/micro-post-service/prisma/prisma.config.ts",
    "prisma:migrate:deploy:file": "prisma migrate deploy --config apps/micro-file-service/prisma/prisma.config.ts",
    "prisma:migrate:deploy": "pnpm prisma:migrate:deploy:gateway && pnpm prisma:migrate:deploy:post && pnpm prisma:migrate:deploy:file",
    "prisma:migrate:status:gateway": "prisma migrate status --config apps/main-gateway-service/prisma/prisma.config.ts",
    "prisma:migrate:status:post": "prisma migrate status --config apps/micro-post-service/prisma/prisma.config.ts",
    "prisma:migrate:status:file": "prisma migrate status --config apps/micro-file-service/prisma/prisma.config.ts",
    "prisma:migrate:status": "pnpm prisma:migrate:status:gateway && pnpm prisma:migrate:status:post && pnpm prisma:migrate:status:file",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/main-gateway-service/test/jest-e2e.json"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@aws-sdk/client-s3": "3.1096.0",
    "@aws-sdk/client-sqs": "3.1096.0",
    "@aws-sdk/s3-presigned-post": "3.1096.0",
    "@aws-sdk/s3-request-presigner": "3.1096.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@nestjs/apollo": "13.4.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.4.2",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/websockets": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "amqp-connection-manager": "4.1.14",
    "amqplib": "2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "1.4.7",
    "graphql": "16.11.0",
    "helmet": "^8.3.0",
    "pg": "8.22.0",
    "redis": "5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.6",
    "sharp": "0.35.3",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-proto": "2.12.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "apps/**/*.ts",
      "libs/**/*.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node"
  }
}
