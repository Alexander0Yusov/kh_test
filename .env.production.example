# Deployment identity (all application image tags are full immutable Git commit SHAs).
GHCR_NAMESPACE=github-owner
GATEWAY_IMAGE_TAG=0000000000000000000000000000000000000000
FILE_SERVICE_IMAGE_TAG=0000000000000000000000000000000000000000
POST_SERVICE_IMAGE_TAG=0000000000000000000000000000000000000000
FRONTEND_IMAGE_TAG=0000000000000000000000000000000000000000
FRONTEND_HOST=www.example.com
API_HOST=api.example.com
ACME_EMAIL=ops@example.com

# Common backend runtime. Compose injects NODE_ENV=production.
RABBITMQ_URL=amqps://user:change-me@rabbitmq.example.com:5671

# Gateway runtime.
GATEWAY_PRISMA_DB_URL=postgresql://gateway_user:change-me@postgres.example.com:5432/gateway_db
SWAGGER_ENABLED=false
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=7200
REDIS_URL=rediss://default:change-me@redis.example.com:6379
CAPTCHA_TTL_SECONDS=300

# File Service runtime. Production S3 CORS must allow the exact frontend origin.
FILE_PRISMA_DB_URL=postgresql://file_user:change-me@postgres.example.com:5432/file_db
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
S3_BUCKET=dzencode-files-production
SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/000000000000/dzencode-file-upload-events-prod
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=60
FILES_MAX_UPLOAD_SIZE_BYTES=102400
FILES_PRESIGNED_POST_TTL_SECONDS=900
FILES_DOWNLOAD_URL_TTL_SECONDS=900

# Post Service runtime.
POST_PRISMA_DB_URL=postgresql://post_user:change-me@postgres.example.com:5432/post_db
